# Eva — пример окружения.
# Скопируйте в .env (локально) или вынесите в docker-compose.override.yml.
# Путь к данным (конфиги окажутся в $EVA_HOME/config)
EVA_HOME=./data
# Уровень логов: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Home Assistant (читаются в plugin_eva_skills)
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
# LLM (прокидываются в конфиг llm-плагинов)
OPENAI_API_KEY=
LM_STUDIO_URL=http://127.0.0.1:1234/v1
